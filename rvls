        if type(wd) ~= "table" then
            wd = { Name = weaponName, Weapon = weaponName, WeaponName = weaponName };
        else
            wd = table.clone(wd);
            wd.Name = weaponName;
        end;
        local skinName = getWeaponSkinName(weaponName, wd);
        if skinName and skinName ~= "" then
            local skinData = clone_cosmetic(skinName, "Skin");
            if skinData then
                wd.Skin = skinData;
            end;
        end;
        return wd;
