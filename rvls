        end;
    end;

    local function vmc_restore(tracked)
        for part, saved in van_pairs(tracked) do
            if part.Parent then
                part.Material = saved.material;
                part.Color = saved.color;
                part.Transparency = saved.transparency;
            end;
            tracked[part] = nil;
        end;
