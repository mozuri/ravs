local __pendingWMVisible = nil;
local __pendingWMText = nil;

local function __isInstance(v)
    return type(v) == "userdata" or (typeof and (function()
        local ok, r = pcall(typeof, v);
        return ok and r == "Instance";
    end)());
end

local function __fire(entry, ...)
    local cb = entry and entry.Callback;
    if cb then
        local ok, err = pcall(cb, ...);
        if not ok then
            warn("[vanilla] control callback: " .. tostring(err));
        end
    end
end

local function __applyVisible(entry)
    local el = entry and entry._swin_el;
    if el ~= nil and entry._visible ~= nil then
        pcall(function() el.Visible = entry._visible and true or false end);
    end
end

local function __syncSwin(entry, v)
    local fn = entry and entry._swin_set;
    if fn then
        pcall(fn, v);
    end
end

local function __mkEntry(kind, flag, Info, extra)
    local e = {
        Type = kind,
        Flag = flag,
        Value = extra and extra.value or Info.Default,
        Callback = Info.Callback or function() end,
        Changed = nil,
        Multi = Info.Multi,
        Values = Info.Values,
        Mode = Info.Mode,
        _visible = (Info.Visible ~= false),
        _swin_el = nil,
        _swin_set = nil,
    };
    function e:SetVisible(v)
        e._visible = (v and true or false);
        __applyVisible(e);
    end
    function e:Display() end
    function e:UpdateColors() end
    function e:Update() end
    function e:OnChanged(fn)
        e.Changed = fn;
        if fn then pcall(fn, e.Value) end
    end
    function e:OnClick(fn) e.Clicked = fn end
    return e;
end

local function __toggleSet(e, v)
    v = (v and true or false);
    e.Value = v;
    __fire(e, v);
    if e.Changed then pcall(e.Changed, v) end
    __syncSwin(e, v);
end

local function __optSet(e, v)
    e.Value = v;
    __fire(e, v);
    if e.Changed then pcall(e.Changed, v) end
    __syncSwin(e, v);
end

