RagebotService = {}
do
    local rb_lastFire = 0;
    local rb_fireRate = 0.0005;
    local rb_conn = nil;
    local rb_deflecting = {};
    local rb_spec = nil;
    pcall(function()
        rb_spec = require(local_player.PlayerScripts.Controllers:WaitForChild("SpectateController", 10));
    end);
    players.PlayerRemoving:Connect(function(plr)
        rb_deflecting[plr] = nil;
        deflecting[plr] = nil;
    end);
    local function rb_updateDeflection()
        local FC = fighter_controller;
        if not FC or not FC.Objects then return end;
        for _, fObj in FC.Objects do
            local plr = fObj.Player;
            if not plr then continue end;
            local alive = fObj.Entity and fObj.Entity:IsAlive();
            local spec = fObj:Get("IsSpectating");
            if not alive or spec then
                rb_deflecting[plr] = false;
                deflecting[plr] = false;
                continue;
            end;
            local eq = fObj.EquippedItem;
            local isKat = eq and eq.ViewModel and eq.ViewModel.Name == "Katana";
            local isDef = false;
            if isKat then
                isDef = (eq._attack_cooldown and eq._attack_cooldown > tick()) or false;
            end;
            rb_deflecting[plr] = isDef;
            deflecting[plr] = isDef;
        end;
    end;
    local function rb_isEnemy(player)
        if player == local_player then return false end;
        if VAN.ragebot.ffa_mode then return true end;
        if rb_spec then
            local okD, duel = pcall(function() return rb_spec.CurrentDuelSubject end);
            local lDueler = (okD and duel) and duel:GetDueler(local_player) or nil;
            local lTeam = lDueler and lDueler:Get("TeamID") or nil;
            if lTeam and duel and duel.Duelers then
                for _, dueler in duel.Duelers do
                    if dueler.Player == player then
                        return dueler:Get("TeamID") ~= lTeam;
                    end;
                end;
            end;
        end;
        local pTeam = player:GetAttribute("TeamID");
        local lTeam = local_player:GetAttribute("TeamID");
        if pTeam and lTeam then return pTeam ~= lTeam end;
        return true;
    end;
    local function rb_getClosest()
        local char = local_player.Character;
        if not char then return nil, nil, nil end;
        local myRoot = char:FindFirstChild("HumanoidRootPart");
        if not myRoot then return nil, nil, nil end;
        local bp, br, bh, bd = nil, nil, nil, 500;
        for _, player in players:GetPlayers() do
            if rb_isEnemy(player) then
                local pc = player.Character;
                local pr = pc and pc:FindFirstChild("HumanoidRootPart") or nil;
                local ph = pc and pc:FindFirstChild("Head") or nil;
                local hum = pc and pc:FindFirstChildWhichIsA("Humanoid") or nil;
                if pr and ph and hum and hum.Health > 0 then
                    local d = (myRoot.Position - pr.Position).Magnitude;
                    if d < bd then bp, br, bh, bd = player, pr, ph, d end;
                end;
            end;
        end;
        return bp, br, bh;
    end;
    local function rb_hasKnife(plr)
        if not plr then return false end;
        local vms = workspace:FindFirstChild("ViewModels");
        if not vms then return false end;
        for _, m in vms:GetChildren() do
            if m:IsA("Model") and string.find(m.Name, plr.Name, 1, true)
                and string.find(m.Name, "Knife", 1, true) then
                return true;
            end;
        end;
        return false;
    end;
    function RagebotService:Init()
        self.active = false;
        self.debounce = false;
        self.lastShot = os.clock();
        self.connection = nil;
    end;
    function RagebotService:FireWeapon(tPlr, tHead, tRoot, desyncCF)
        local fighter = fighter_controller.LocalFighter;
        if not fighter then return end;
        local item = fighter.EquippedItem;
        if not item then return end;
        if tick() - rb_lastFire < rb_fireRate then return end;
        rb_lastFire = tick();
        local originPos = (desyncCF and desyncCF.Position) or tRoot.Position;
        local targetPos = tHead.Position;
        local aimCF = CFrame.lookAt(originPos, targetPos);
        local targetCF = tHead.CFrame;
        local rOff = Vector3.new((math.random() - 0.5) * 0.1, (math.random() - 0.5) * 0.1, (math.random() - 0.5) * 0.1);
        local objOff = tHead.CFrame:ToObjectSpace(CFrame.new(targetPos + rOff));
        local cdata = {};
        cdata[utf8.char(1)] = {
            [utf8.char(0)] = utility:EncodeCFrame(aimCF),
            [utf8.char(1)] = utility:EncodeCFrame(targetCF),
            [utf8.char(2)] = tHead,
            [utf8.char(3)] = utility:EncodeCFrame(objOff),
        };
        replicated_storage.Remotes.Replication.Fighter.UseItem:FireServer(
            item:Get("ObjectID"), enum_lib:ToEnum("StartShooting"), cdata, nil);
    end;
    function RagebotService:Start()
        if rb_conn then return end;
        rb_conn = run_service.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
            rb_updateDeflection();
            if not VAN.ragebot.enable then
                RagebotService:Stop();
                return;
            end;
            local tPlr, tRoot, tHead = rb_getClosest();
            local desyncCF = nil;
            if tRoot and tHead then
                local dp;
                if rb_hasKnife(tPlr) then dp = (tRoot.CFrame * CFrame.new(0, 6, 0)).Position;
                else dp = (tRoot.CFrame * CFrame.new(0, 1, 2)).Position end;
                desyncCF = CFrame.lookAt(dp, tHead.Position);
            end;
            if desyncCF and local_player.Character then
                local myRoot = local_player.Character:FindFirstChild("HumanoidRootPart");
                if myRoot then
                    local oCF, oV, oRV = myRoot.CFrame, myRoot.Velocity, myRoot.RotVelocity;
                    myRoot.CFrame = desyncCF;
                    pcall(function()
                        run_service:BindToRenderStep("__van_restore", 101, function()
                            if myRoot then
                                myRoot.CFrame = oCF;
                                myRoot.Velocity = oV;
                                myRoot.RotVelocity = oRV;
                            end;
                            run_service:UnbindFromRenderStep("__van_restore");
                        end);
                    end);
                end;
            end;
            if not tPlr or not tHead or not tRoot then return end;
            local okH, riot = pcall(has_riot, tPlr);
            if rb_deflecting[tPlr] or (okH and riot) then return end;
            local fighter = fighter_controller.LocalFighter;
            if not fighter then DesyncService:Stop(); return end;
            local item = fighter.EquippedItem;
            if not item then DesyncService:Stop(); return end;
            local tf = fighter_controller:GetFighter(tPlr);
            if not tf then DesyncService:Stop(); return end;
            local vm = item.ViewModel;
            if not vm then DesyncService:Stop(); return end;
            local tent = tf.Entity;
            if not tent or tent:Get("IsInvincible") then DesyncService:Stop(); return end;
            local ammo = item:Get("Ammo");
            if (ammo == nil or ammo > 0) and not vm:IsAnimationPlaying("Reload") then
                RagebotService:FireWeapon(tPlr, tHead, tRoot, desyncCF);
            else
                if not vm:IsAnimationPlaying("Reload") then
                    setthreadidentity(2);
                    item:Input("StartReloading");
                    setthreadidentity(7);
                end;
            end;
        end));
    end;
    function RagebotService:Stop()
        if rb_conn then rb_conn:Disconnect(); rb_conn = nil end;
        self.debounce = false;
        DesyncService:Stop();
    end;
    RagebotService:Init();
end;
