        else
            part.Material = tracked[part].material;
        end;
        if cfg.color_enable then
            part.Color = cfg.color;
        else
            part.Color = tracked[part].color;
        end;
        part.Transparency = math.clamp((cfg.transparency or 0) / 100, 0, 1);
