do
    if VAN.autoLoadUnlockAll == nil then VAN.autoLoadUnlockAll = true end;
    if VAN.autoLoadUnlockAll ~= false then VAN.unlockSkins = true else VAN.unlockSkins = false end;
    local unl_equipped, unl_favorites = {}, {};
    local unl_viewing = nil;
    local function unl_norm(s)
        if type(s) ~= "string" then return "" end;
        return s:lower():gsub("[%s%-%_]+", "");
    end;
    local function unl_resolveName(sent, ctype)
        if type(sent) ~= "string" or sent == "" then return sent end;
        if cosmetic_lib.Cosmetics[sent] then return sent end;
        local ns = unl_norm(sent);
        if ns ~= "" then
            for k, v in pairs(cosmetic_lib.Cosmetics) do
                if type(v) == "table" and (v.Type == nil or v.Type == ctype) then
                    if unl_norm(k) == ns or unl_norm(v.Name or "") == ns then return k end;
                end;
            end;
        end;
        return sent;
    end;
    local function unl_resolve(weaponName, weapon_data)
        if not weaponName then return nil end;
        if unl_equipped[weaponName] then return weaponName end;
        if weapon_data then
            for _, key in van_ipairs({ weapon_data.Name, weapon_data.Weapon, weapon_data.WeaponName }) do
                if key and unl_equipped[key] then return key end;
            end;
        end;
