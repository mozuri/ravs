            end;
        end;

        if ammo ~= nil and equipped.Info and equipped.Info.MaxAmmo then
            G2L["23"]["Text"] = tostring(ammo) .. "/" .. tostring(equipped.Info.MaxAmmo);
        elseif ammo ~= nil then
