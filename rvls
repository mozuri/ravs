        p = lua_folder .. '/' .. name .. '.txt';
        if isfile and isfile(p) then return p end;
        return nil;
    end;

    local function runCode(code)
        if not code or code:gsub('%s', '') == '' then
            return Library:Notify('nothing to execute', 2);
