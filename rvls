function VAN_Stage(msg)
    print("[vanilla-merge] stage: " .. tostring(msg));
    pcall(function()
        local f = getgenv().__VAN_BOOT;
        if f then f(msg) end
    end);
    pcall(function()
        if appendfile then
            appendfile("Vanilla/vanilla_boot.log", tostring(msg) .. "\n");
        end
    end);
end
